{
  "name": "howl-browser",
  "version": "0.5.0",
  "description": "Howlcoin wallet + Howl Search native shell (Capacitor WebView)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "sync:www": "node scripts/sync-www.js",
    "build": "npm run sync:www",
    "cap:sync": "npm run sync:www && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "doctor": "npx cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/status-bar": "^6.0.2",
    "@capgo/inappbrowser": "^6.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
